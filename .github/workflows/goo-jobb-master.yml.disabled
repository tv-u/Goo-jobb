name: GOO-JOBB WORLDWIDE MASTER

on:
  workflow_dispatch:
  schedule:
    - cron: "17 * * * *"

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: goo-jobb-worldwide
  cancel-in-progress: false

jobs:

  sync-build:
    name: WORLDWIDE REAL JOB SYNC
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:

      - name: Checkout
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          clean: true

      - name: Node
        uses: actions/setup-node@v5
        with:
          node-version: 24
          cache: npm

      - name: Validate project
        run: |
          set -e
          test -f public/index.html
          test -f scripts/source-expansion.mjs
          echo "PROJECT OK"

      - name: Worldwide real job sync
        run: |
          set -e
          node scripts/goo-jobb-master-sync.mjs

      - name: Build enterprise index
        run: |
          set -e
          if [ -f scripts/build-enterprise-index.mjs ]; then
            node scripts/build-enterprise-index.mjs
          fi

      - name: Build V2 search
        run: |
          set -e
          if [ -f scripts/build-v2-search.mjs ]; then
            node scripts/build-v2-search.mjs
          fi

      - name: Build SEO
        run: |
          set -e
          if [ -f scripts/build-seo-v2.mjs ]; then
            node scripts/build-seo-v2.mjs
          fi

      - name: Validate JSON
        run: |
          set -e

          node scripts/goo-jobb-validate.mjs

          for f in \
            public/jobs.json \
            public/jobs-enterprise.json \
            public/jobs-worldwide.json \
            public/jobs-search-index.json \
            public/goo-jobb-source-health.json \
            public/sync-meta.json
          do
            if [ -f "$f" ]; then
              node -e "JSON.parse(require('fs').readFileSync('$f','utf8')); console.log('$f OK')"
            fi
          done

      - name: Show production metrics
        run: |
          echo "======================================"
          echo " GOO-JOBB WORLDWIDE METRICS"
          echo "======================================"

          node - <<'NODE'
          const fs = require("fs");

          for (const f of [
            "public/jobs-enterprise.json",
            "public/jobs-worldwide.json"
          ]) {
            if (!fs.existsSync(f)) continue;

            const x = JSON.parse(fs.readFileSync(f));
            const jobs = Array.isArray(x) ? x : x.jobs || [];

            console.log(f, jobs.length);
          }

          if (fs.existsSync("public/goo-jobb-source-health.json")) {
            const h = JSON.parse(
              fs.readFileSync(
                "public/goo-jobb-source-health.json"
              )
            );

            console.log("sources:", h.sourceCount);
            console.log("healthy:", h.healthySources);
            console.log("failed:", h.failedSources);
            console.log("fake:", h.fakeJobs);
          }
          NODE

      - name: Commit generated data
        run: |
          set -e

          git config user.name "GOO-JOBB Bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add public scripts .github/workflows/goo-jobb-master.yml

          if git diff --cached --quiet; then
            echo "No generated changes."
            exit 0
          fi

          git commit -m "chore: worldwide real job expansion"

      - name: Safe push
        run: |
          set -e

          git fetch origin main

          for attempt in 1 2 3 4 5; do
            if git push origin HEAD:main; then
              echo "PUSH SUCCESS"
              exit 0
            fi

            git fetch origin main

            git rebase origin/main || {
              git rebase --abort || true
              git reset --soft origin/main
              git add public scripts .github/workflows/goo-jobb-master.yml

              if ! git diff --cached --quiet; then
                git commit -m "chore: synchronize worldwide job data"
              fi
            }

            sleep $((attempt * 2))
          done

          exit 1

  pages:
    name: GITHUB PAGES DEPLOY
    needs: sync-build
    runs-on: ubuntu-latest
    timeout-minutes: 15

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    permissions:
      contents: read
      pages: write
      id-token: write

    steps:

      - name: Checkout final main
        uses: actions/checkout@v5
        with:
          fetch-depth: 1

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages
        uses: actions/upload-pages-artifact@v4
        with:
          path: "."

      - name: Deploy Pages
        id: deployment
        uses: actions/deploy-pages@v4

      - name: Complete
        run: |
          echo "======================================"
          echo " GOO-JOBB WORLDWIDE DEPLOYED"
          echo "======================================"
          echo "https://tv-u.github.io/Goo-jobb/"

name: GOO-JOBB V4 Live Sync + Pages

on:
  workflow_dispatch:
  push:
    branches: [main]
  schedule:
    - cron: "17 * * * *"

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: goo-jobb-pages
  cancel-in-progress: false

jobs:
  sync-build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - name: Install
        run: npm ci

      - name: Real worldwide sync
        run: node scripts/goo-jobb-master-sync.mjs
        env:
          GOO_JOBB_WORLDWIDE: "1"

      - name: Build indexes
        run: |
          node scripts/build-enterprise-index.mjs
          node scripts/build-v2-search.mjs
          node scripts/build-seo-v2.mjs

      - name: Validate
        run: node scripts/goo-jobb-validate.mjs

      - name: Commit generated data
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add public
          if git diff --cached --quiet; then
            echo "No generated changes"
          else
            git commit -m "chore: refresh worldwide real jobs"
            git push origin HEAD:main
          fi

  pages:
    needs: sync-build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Checkout final main
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 1

      - name: Prepare Pages artifact
        run: |
          rm -rf dist
          mkdir -p dist
          cp -a public/. dist/

          if [ -f index.html ]; then
            cp index.html dist/index.html
          fi

          mkdir -p dist/public
          cp -a public/. dist/public/

          mkdir -p dist/ai
          cp public/ai/local-ai-engine.json dist/ai/
          cp public/ai/goo-jobb-ai.js dist/ai/
          cp public/ai/goo-jobb-live.js dist/ai/

          for f in \
            jobs.json \
            jobs-enterprise.json \
            jobs-worldwide.json \
            jobs-search-index.json \
            sync-meta.json \
            goo-jobb-meta.json \
            source-health.json \
            goo-jobb-source-health.json \
            worldwide-meta.json \
            worldwide-source-health.json \
            companies-index.json \
            facets.json \
            jobs-facets.json \
            enterprise-meta.json
          do
            [ -f "public/$f" ] && cp "public/$f" "dist/$f"
          done

          touch dist/.nojekyll

          test -s dist/index.html
          test -s dist/jobs-worldwide.json
          test -s dist/jobs-enterprise.json
          test -s dist/ai/local-ai-engine.json
          test -s dist/ai/goo-jobb-ai.js
          test -s dist/ai/goo-jobb-live.js

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: dist

      - name: Deploy Pages
        id: deployment
        uses: actions/deploy-pages@v4
